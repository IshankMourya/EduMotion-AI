# EduMotion AI - Environment Variables
# Copy to .env.local and fill in your values

# ============================================
# Supabase Cloud (Required)
# ============================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================
# Backend (FastAPI)
# ============================================
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ============================================
# Local AI Services
# ============================================
# Ollama (Qwen3 27B) - Update with your exact model name from `ollama list`
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:27b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Piper TTS
PIPER_BINARY_PATH=/opt/homebrew/bin/piper
PIPER_MODEL_PATH=/opt/homebrew/share/piper-voices/en_US-lessac-medium.onnx
PIPER_CONFIG_PATH=/opt/homebrew/share/piper-voices/en_US-lessac-medium.onnx.json

# ============================================
# Video Rendering
# ============================================
REMOTION_SERVE_URL=http://localhost:4000
FFMPEG_PATH=ffmpeg
COMFYUI_URL=http://127.0.0.1:8188
RENDER_MODE=remotion  # "remotion" or "wan21"

# ============================================
# App Configuration
# ============================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
LOG_LEVEL=debug

# Video settings
VIDEO_TARGET_DURATION_MIN=60
VIDEO_TARGET_DURATION_MAX=180
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_FPS=30
VIDEO_BITRATE=5000k

# Processing limits
MAX_PDF_SIZE_MB=50
MAX_PDF_PAGES=100
MAX_CHUNKS_PER_PROJECT=500