# EduMotion AI - Local Development Overrides
# This file is gitignored. Copy .env.example to .env.local and modify.

# Supabase Cloud (Required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Backend
BACKEND_PORT=8000
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Local AI - Update these with your actual paths
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:27b
OLLAMA_EMBED_MODEL=nomic-embed-text

PIPER_BINARY_PATH=/opt/homebrew/bin/piper
PIPER_MODEL_PATH=/opt/homebrew/share/piper-voices/en_US-lessac-medium.onnx

# Video
REMOTION_SERVE_URL=http://localhost:4000
FFMPEG_PATH=ffmpeg
COMFYUI_URL=http://127.0.0.1:8188
RENDER_MODE=remotion